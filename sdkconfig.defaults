# Enable the built-in certificate bundle for TLS server verification
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Enable SNTP for system time sync (required by OneNET token generation)
CONFIG_LWIP_SNTP_ENABLED=y

# ===== OneNET MQTT connection =====
CONFIG_MQTT_DRIVER_BROKER_URI="mqtt://studio-mqtt.heclouds.com:1883"
CONFIG_MQTT_DRIVER_ENABLE_ONENET_AUTH=y
CONFIG_MQTT_DRIVER_PRODUCT_ID="j0X1m59r64"
CONFIG_MQTT_DRIVER_DEVICE_NAME="S3"
CONFIG_MQTT_DRIVER_DEVICE_KEY="c3prWFNiN0lRSkZHVVVwRG5EYjlLQTN2RjE5akx5OTE="
CONFIG_MQTT_DRIVER_TOKEN_VALID_SECONDS=3600
CONFIG_MQTT_DRIVER_PROPERTY_ID="temp"
