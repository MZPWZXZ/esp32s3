menu "UART Application Configuration"

    config UART_APP_ENABLED
        bool "Enable UART"
        default y
        help
            When enabled, uart_app_start() initializes the UART peripheral
            and creates the receive task. Disable to skip UART entirely.

    config UART_APP_BAUD_RATE
        int "UART baud rate"
        default 115200
        range 300 4000000
        help
            Baud rate used by the UART communication.

    config UART_APP_TX_GPIO
        int "UART TX GPIO number"
        default 2
        help
            GPIO number used as the UART TX pin.

    config UART_APP_RX_GPIO
        int "UART RX GPIO number"
        default 1
        help
            GPIO number used as the UART RX pin.

    config UART_APP_PERIODIC_SEND
        bool "Send 0xAA periodically"
        default y
        help
            When enabled, a task sends the byte 0xAA over UART at a fixed
            interval (see UART_APP_SEND_INTERVAL_MS).

    config UART_APP_SEND_INTERVAL_MS
        int "Periodic send interval (ms)"
        default 1000
        range 10 60000
        depends on UART_APP_PERIODIC_SEND
        help
            Interval in milliseconds between two periodic 0xAA transmissions.

endmenu
